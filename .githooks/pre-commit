#!/usr/bin/env bash
#
# Pre-commit hook: block commits that contain potential secrets.
# Install: git config core.hooksPath .githooks
#

set -euo pipefail

# Patterns that should never appear in committed code
SECRET_PATTERNS=(
  'sk-ant-[A-Za-z0-9_\-]+'          # Anthropic API key
  'sk-[A-Za-z0-9_\-]{20,}'          # Generic secret key
  'ghp_[A-Za-z0-9]{36}'             # GitHub personal access token
  'gho_[A-Za-z0-9]{36}'             # GitHub OAuth token
  'ghs_[A-Za-z0-9]{36}'             # GitHub server token
  'ghr_[A-Za-z0-9]{36}'             # GitHub refresh token
  'ANTHROPIC_API_KEY=[^\s$]+'        # Hardcoded Anthropic key assignment
  'GITHUB_TOKEN=[^\s$]+'             # Hardcoded GitHub token assignment
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

FOUND=0
for pattern in "${SECRET_PATTERNS[@]}"; do
  # Search staged content (not working tree) for secrets
  MATCHES=$(git diff --cached -U0 --no-color | grep -E "^\+" | grep -vE "^\+\+\+" | grep -oE "$pattern" || true)
  if [ -n "$MATCHES" ]; then
    if [ "$FOUND" -eq 0 ]; then
      echo "🚨 Potential secret detected in staged changes:"
      echo ""
    fi
    FOUND=1
    echo "  Pattern: $pattern"
    echo "  Match:   $(echo "$MATCHES" | head -1 | sed 's/.\{8\}$/********/')"
    echo ""
  fi
done

if [ "$FOUND" -ne 0 ]; then
  echo "Commit blocked. Remove secrets before committing."
  echo "If this is a false positive, use: git commit --no-verify"
  exit 1
fi
