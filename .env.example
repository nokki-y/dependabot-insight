# Environment variables for local development of dependabot-insight.
#
# This file is for developers who contribute to dependabot-insight itself.
# Users who install the Action via their workflow do NOT need this file —
# all variables are set automatically by action.yml.
#
# Usage:
#   cp .env.example .env
#   # Fill in your values (NEVER commit .env files with real credentials)
#   npx tsx src/impact-analysis.ts
#   npx tsx src/test-recommendation.ts

GITHUB_TOKEN=
ANTHROPIC_API_KEY=
REPOSITORY=owner/repo
PR_NUMBER=123
DEPENDENCY_NAMES=package-name
UPDATE_TYPE=patch
DRY_RUN=true
AI_MODEL=claude-sonnet-4-6
AI_LANGUAGE=en
BASE_URL=
